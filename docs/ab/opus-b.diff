diff --git a/app/src/integrations/sheets-append.ts b/app/src/integrations/sheets-append.ts
index 063cdb7..8002661 100644
--- a/app/src/integrations/sheets-append.ts
+++ b/app/src/integrations/sheets-append.ts
@@ -12,6 +12,29 @@ interface SheetsResponse {
 const isSheetsResponse: Guard<SheetsResponse> = (value): value is SheetsResponse =>
   isRecord(value) && isString(value.status);
 
+/**
+ * Кампанія (`utmCampaign`) приходить із форми сайту, але в `Lead` із core/types.ts її поки немає:
+ * core міняється окремим PR платформної команди (див. docs/core-change-request.md).
+ * Доти читаємо поле як необов'язкове розширення ліда — `unknown` плюс guard, без довіри до форми.
+ */
+type LeadWithCampaign = Lead & { utmCampaign?: unknown };
+
+/**
+ * Кампанія для колонки таблиці. Відсутня — порожня комірка, це штатний випадок.
+ * Присутня, але не рядок — теж порожня комірка, проте з попередженням: зіпсоване поле форми
+ * має бути видно в журналі. Зупиняти через нього доставку ліда не варто — кампанія це
+ * атрибуція, а не дані обліку, і через неї не має зупинятись уся синхронізація.
+ * Значення в журнал не пишемо, лише тип: у ньому може бути що завгодно.
+ */
+const campaignOf = (lead: Lead): string => {
+  const value = (lead as LeadWithCampaign).utmCampaign;
+  if (isString(value)) return value;
+  if (value !== undefined) {
+    log.warn(`sheets-append: lead ${lead.id} has non-string utmCampaign (${typeof value}), writing empty cell`);
+  }
+  return "";
+};
+
 export const sheetsAppend: Integration = {
   name: "sheets-append",
   requiredEnv: ["SHEETS_WEBHOOK_URL", "SHEETS_TOKEN"],
